# =============================================================================
# MyASA — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------

# String de conexão PostgreSQL.
#
# Replit (desenvolvimento): fornecida automaticamente pelo ambiente.
#
# Supabase (produção): use o Transaction Pooler (porta 6543) para servidores
# stateless (Vercel Functions), ou a conexão direta (porta 5432) para
# servidores de longa duração (Railway, Render, Fly.io).
#
# Transação Pooler (serverless):
#   postgresql://postgres.[ref]:[senha]@aws-0-[região].pooler.supabase.com:6543/postgres
#
# Conexão direta (servidor persistente — recomendado para a API Express):
#   postgresql://postgres.[ref]:[senha]@db.[ref].supabase.co:5432/postgres
#
# IMPORTANTE: ao usar Transaction Pooler, adicione ?pgbouncer=true à URL e
# configure o Drizzle com { prepare: false } no Pool.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/myasa

# -----------------------------------------------------------------------------
# Autenticação JWT
# -----------------------------------------------------------------------------

# Chave secreta para assinar os access tokens (expira em 15 min).
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# OBRIGATÓRIO em produção (NODE_ENV=production). Em desenvolvimento usa fallback inseguro.
JWT_ACCESS_SECRET=

# Chave secreta para assinar os refresh tokens (expira em 30 dias).
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# OBRIGATÓRIO em produção (NODE_ENV=production). Em desenvolvimento usa fallback inseguro.
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# Inteligência Artificial (Anthropic / ASA)
# -----------------------------------------------------------------------------

# Chave da API Anthropic. Obrigatório.
# Obtenha em: https://console.anthropic.com/settings/keys
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...

# URL base da API Anthropic. Opcional.
# - Deixe em branco (ou omita) para usar a API oficial: https://api.anthropic.com
# - No Replit, esta variável aponta para o proxy gerenciado pelo Replit.
# - Em produção fora do Replit, deixe em branco ou aponte para seu proxy.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# -----------------------------------------------------------------------------
# Servidor HTTP
# -----------------------------------------------------------------------------

# Porta em que cada serviço escuta. No Replit, definida automaticamente.
# Para desenvolvimento local, cada serviço precisa de uma porta diferente.
PORT=3000

# Prefixo de caminho base para roteamento (ex: /web-admin, /mobile).
# No Replit, definido automaticamente por artifact.
# Para deploy raiz (Vercel/Netlify), use: BASE_PATH=/
BASE_PATH=/

# Ambiente de execução. Em produção, DEVE ser "production".
# Quando "production": JWT secrets sem valor lançam erro na inicialização.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Bootstrap / Reset (uso único — remover após execução)
# -----------------------------------------------------------------------------

# Ativa o reset destrutivo do banco de dados e criação do admin inicial.
# Só funciona UMA VEZ por banco (controlado por _bootstrap_log).
# Defina como "1" apenas na primeira inicialização em produção.
# REMOVA após o primeiro deploy bem-sucedido.
# RESET_PROD_DB=1

# Senha do administrador criado pelo bootstrap.
# Obrigatório quando RESET_PROD_DB=1.
# BOOTSTRAP_ADMIN_PASSWORD=senha-forte-aqui

# -----------------------------------------------------------------------------
# Variáveis Replit (somente desenvolvimento no Replit — não usar em produção)
# -----------------------------------------------------------------------------

# Estas variáveis são injetadas automaticamente pelo ambiente Replit.
# Não as defina manualmente fora do Replit.
# REPLIT_DEV_DOMAIN=
# REPLIT_EXPO_DEV_DOMAIN=
# REPLIT_INTERNAL_APP_DOMAIN=
# REPL_ID=
